<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Functional tests of the rules in MyCodingZone.CodeRules: does each rule report exactly the right code?
        Every test runs one rule against a small piece of code with Assert.That.CodeRule. No solution is parsed, every call
        builds its own engine. The rule project itself runs the rules against this solution (generated tests).
    -->
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <!-- CA1515: MSTest classes are public. CA1707: Should_X_When_Y. CA2007: ConfigureAwait is meaningless in test methods. -->
        <NoWarn>$(NoWarn);CA1515;CA1707;CA1826;CA2007</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="AspNetCore.Simple.MsTest.Sdk" />
    </ItemGroup>

    <!--
      Siemens.AspNet.CodeRules.MSTest comes transitively from MyCodingZone.CodeRules (Assert.That.CodeRule), including its
      test generator. This project tests single rules and has no ICodeRuleSetup, so the generator is removed here
      (CODERULE_GEN_0001 otherwise). The rule project keeps it and generates one test per rule.
    -->
    <Target Name="RemoveCodeRuleTestGenerator" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Siemens.AspNet.CodeRules.MSTest.SourceGenerator'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
        <Using Include="AspNetCore.Simple.MsTest.Sdk" />
        <Using Include="Siemens.AspNet.CodeRules.MSTest" />
        <Using Include="Siemens.AspNet.CodeRules.Engine" />
    </ItemGroup>

    <ItemGroup>
        <!-- The rules under test. Brings the engine and its MSTest adapter (Assert.That.CodeRule) along. -->
        <ProjectReference Include="..\MyCodingZone.CodeRules\MyCodingZone.CodeRules.csproj" />
    </ItemGroup>

</Project>
