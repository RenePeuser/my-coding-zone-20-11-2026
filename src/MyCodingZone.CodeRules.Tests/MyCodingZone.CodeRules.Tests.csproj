<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <!-- Common settings have to be removed when pipelines works correctly with Directory.Build.props -->
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <!--Project specific settings-->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- CA1032/CA2225/CA1054/CA1056: demo infrastructure (exceptions, implicit operators, string URLs), not a public API.
             CA1062: the test framework never passes null. -->
        <NoWarn>CA1515;CA1707;CA1826;CA1032;CA2225;CA1054;CA1056;CA1062</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Abstractions" />
        <PackageReference Include="AspNetCore.Simple.MsTest.Sdk" />
        <PackageReference Include="Extensions.Pack" />
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Solution.Parser" />
    </ItemGroup>
</Project>
